{
  "name": "karcianix",
  "version": "0.11.1",
  "private": true,
  "type": "module",
  "description": "Deterministyczny symulator balansu talii Galów i Rzymian",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "play": "node src/play-server.ts",
    "cards:csv": "node scripts/sync-unit-csv.ts",
    "cards:csv:check": "node scripts/sync-unit-csv.ts --check",
    "pretest": "npm run cards:csv:check",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "simulate": "node src/cli.ts simulate",
    "experiment": "node src/cli.ts experiment",
    "replay": "node src/cli.ts replay"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
